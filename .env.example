# ==============================================================================
# Kata — Environment Configuration Template
# Copy this file to .env and fill in the required credentials. Never commit .env.
# ==============================================================================

# --- Server & Runtime ---
PORT=8000
HOST=0.0.0.0
DEBUG=false
LOG_LEVEL=INFO
FRONTEND_URL=http://localhost:5173

# --- Default Execution Venue ---
# Available options: hyperliquid, drift
DEFAULT_VENUE=hyperliquid

# --- Database (Supabase / PostgreSQL) ---
# Required for persisting trade records, allocations, signals, and learning patterns.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# --- AI & Reasoning Engine ---
# Provider options: deepseek, anthropic, openai
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-reasoner
DEEPSEEK_API_KEY=your-deepseek-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# --- Hyperliquid Execution Venue ---
HYPERLIQUID_API_URL=https://api.hyperliquid.xyz
HYPERLIQUID_ACCOUNT_ADDRESS=0xYourAccountOrAgentAddress
HYPERLIQUID_SECRET_KEY=0xYourPrivateKeyOrApiSecret
HYPERLIQUID_TESTNET=false

# --- Drift / Solana Execution Venue ---
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
DRIFT_AUTHORITY_PUBKEY=YourSolanaAuthorityPublicKey
DRIFT_KEYPAIR_PATH=/path/to/id.json
DRIFT_ENV=mainnet-beta

# --- Optional Non-Custodial Delegation (Privy) ---
# Leave blank if running in standalone keypair / API secret mode.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_AUTHORIZATION_KEY_ID=
PRIVY_AUTHORIZATION_KEY_PRIVATE_KEY=

# --- Market Data APIs ---
COINGECKO_API_KEY=
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- Worker Knobs ---
WORKER_ENABLE_MULTI_LEVEL_LEARNING=true
WORKER_ENABLE_RECOMMENDATION_RESOLUTION=true
SIGNAL_PUBLISH_CONFIDENCE_FLOOR=0.60
